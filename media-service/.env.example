# Server
PORT=8080
MEDIA_RTMP_PORT=1935
MEDIA_HTTP_PORT=8000

# Same database as the API service (this service only reads/writes the
# streamKey and isLive fields on the users collection)
MONGO_URI=mongodb://localhost:27017/omexlive

# Object storage / CDN sync (optional — omit to just serve HLS locally
# from this instance, e.g. for local dev or a small single-instance setup)
S3_BUCKET=
S3_REGION=auto
# Only needed for non-AWS S3-compatible providers (Cloudflare R2,
# DigitalOcean Spaces, MinIO, Backblaze B2...). Leave unset for AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

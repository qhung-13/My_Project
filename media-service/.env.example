# HTTP health endpoint, RTMP ingest, and local HLS server
PORT=8080
MEDIA_RTMP_PORT=1935
MEDIA_HTTP_PORT=8000

# Same database as the API (used only to validate stream keys).
MONGO_URI=mongodb://localhost:27017/omexlive?replicaSet=rs0

# Authenticated media lifecycle callbacks to the backend.
BACKEND_INTERNAL_URL=http://localhost:5000/api/v1
MEDIA_SERVICE_SECRET=use-the-exact-same-32-character-secret-as-backend

# Optional object storage / CDN sync. Omit to serve HLS locally.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Delay before removing temporary HLS files after a stream ends.
HLS_CLEANUP_DELAY_MS=15000

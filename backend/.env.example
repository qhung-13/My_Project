# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API / connect
# via Socket.IO. No trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost

# Database
MONGO_URI=mongodb://localhost:27017/omexlive

# Redis — required for horizontal scaling (Socket.IO adapter + presence
# store). Optional for local single-instance dev; falls back to in-memory.
REDIS_URL=redis://localhost:6379

# Playback URL for live HLS streams (see src/utils/hlsUrl.js).
# Set CDN_BASE_URL if media-service is syncing HLS output to S3 + a CDN
# sits in front of that bucket. Otherwise MEDIA_SERVICE_URL points
# directly at the media-service's own HTTP server (local dev / small
# single-instance deployments).
CDN_BASE_URL=
MEDIA_SERVICE_URL=http://localhost:8000/live

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (passport)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (OTP / notifications) - Brevo SMTP
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

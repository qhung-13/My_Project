# Docker Compose environment (copy to .env and fill secrets)

# Core security
JWT_SECRET=
MEDIA_SERVICE_SECRET=
MEDIA_PUBLISH_AUTH_SECRET=
AGENT_SERVICE_SECRET=
AGENT_SERVICE_URL=http://localhost:8001

# Public URLs / CORS
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost,http://localhost:5173
RTMP_SERVER_URL=rtmp://localhost:1935/live
MEDIA_SERVICE_URL=http://localhost:8080/live
MEDIA_CONTROL_URL=http://localhost:8080
HLS_CLEANUP_DELAY_MS=15000
CDN_BASE_URL=

# Frontend build-time variables
VITE_API_URL=http://localhost:5000/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo SMTP
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Stripe backend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional S3-compatible HLS storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STREAM_AUTH_SWEEP_INTERVAL_MS=2000

# Optional: required only when enabling the AI Creator Coach profile.
GOOGLE_API_KEY=

# OBS signed credential lifetime; reset the stream key to revoke immediately.
INGEST_SIGNATURE_TTL_SECONDS=315360000

# Optional ADK model override; default follows the stable Flash alias.
GOOGLE_ADK_MODEL=gemini-flash-latest
